# ==============================================================================
# Cable Manufacturing Job-Work ERP - Environment Configuration Example
# Copy this file to '.env' for local development.
# WARNING: NEVER use placeholder secrets in production environments!
# ==============================================================================

# Application Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Replica Set Connection String
# For Docker internal network: mongodb://mongo:27017/erp_db?replicaSet=rs0
# For Windows host (dev / compass): mongodb://localhost:27017/erp_db?replicaSet=rs0&directConnection=true
MONGODB_URI=mongodb://localhost:27017/erp_db?replicaSet=rs0&directConnection=true

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_placeholder_min_16_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_placeholder_min_16_chars
JWT_REFRESH_EXPIRES_IN=7d

# Initial Super Admin Bootstrap Credentials
SUPER_ADMIN_EMAIL=superadmin@mfolks.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123456
SUPER_ADMIN_EMPLOYEE_CODE=EMP-SA-001

# Allowed CORS Origins (comma-separated or '*' for dev)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Application Logging Level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace' | 'silent')
LOG_LEVEL=debug
